---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /**
   * 'narrow' (por defecto): columna editorial de lectura para casos de estudio.
   * 'wide': lienzo amplio estilo editorial para la One-Page.
   */
  width?: 'narrow' | 'wide';
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  width = 'narrow',
} = Astro.props;
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink-primary)] selection:bg-accent-blue selection:text-white">
    <!-- Padding superior para compensar el Navbar fixed -->
    <div
      class:list={[
        'mx-auto flex flex-col min-h-screen justify-between',
        width === 'wide'
          ? 'max-w-[1440px] px-5 sm:px-8 lg:px-12 pt-28 pb-10 md:pt-36'
          : 'max-w-4xl px-6 pt-24 pb-16 md:pt-32 md:pb-24',
      ]}
    >
      <main class="w-full">
        <slot />
      </main>
    </div>
  </body>
</html>