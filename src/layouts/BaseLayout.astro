---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const { 
  title = t('site.title'), 
  description = "Minimalist Portfolio - Product Design & Architecture" 
} = Astro.props;
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink-primary)] selection:bg-[var(--color-accent-volt)] selection:text-black">
    <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 flex flex-col min-h-screen justify-between">
      <main class="w-full">
        <slot />
      </main>
    </div>
  </body>
</html>