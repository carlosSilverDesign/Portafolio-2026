---
import BaseLayout from './BaseLayout.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import ProjectContext from '../components/ProjectContext.astro';
import InThisCaseNav from '../components/InThisCaseNav.astro';
import Testimonial from '../components/Testimonial.astro';
import ProjectFooter from '../components/ProjectFooter.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ArrowLeft } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const data = project.data;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeUrl = lang === 'es' ? '/' : `/${lang}`;
---

<BaseLayout title={`${data.title} — ${data.headline}`} description={data.overview}>
  <article class="w-full">
    <!-- Breadcrumb & Botón Volver -->
    <nav class="flex items-center gap-2 mb-10 font-mono text-xs text-[var(--color-ink-muted)]">
      <a href={homeUrl} class="inline-flex items-center gap-1.5 hover:text-black transition-colors">
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Home</span>
      </a>
      <span>/</span>
      <span class="text-[var(--color-ink-primary)] truncate">{data.title}</span>
    </nav>

    <!-- Header del Proyecto (Hikatapixel Style) -->
    <header class="space-y-4 mb-10">
      {data.category && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-mono border border-[var(--color-border-subtle)] bg-[var(--color-surface)] text-[var(--color-ink-secondary)]">
          {data.category}
        </span>
      )}

      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight text-[var(--color-ink-primary)] leading-[1.15]">
        {data.headline}
      </h1>

      {data.tags && data.tags.length > 0 && (
        <p class="font-mono text-xs text-[var(--color-ink-muted)] pt-2 leading-relaxed">
          {data.tags.join('  ·  ')}
        </p>
      )}
    </header>

    <!-- Data Strip: Project / Timeline / Role -->
    {data.meta && (
      <ProjectMeta
        client={data.meta.client}
        timeline={data.meta.timeline}
        role={data.meta.role}
      />
    )}

    <!-- Overview + Tools & Methods + Team -->
    <ProjectContext
      overview={data.overview}
      toolsAndMethods={data.toolsAndMethods}
      team={data.team}
    />

    <!-- Navegación anclada ('In this case') -->
    <InThisCaseNav
      inThisCase={data.inThisCase}
      hasTestimonial={Boolean(data.testimonial)}
    />

    <!-- Secciones del Caso ('In this case') con Renderizado Condicional -->
    <div class="space-y-16 my-12">
      {data.inThisCase?.problem && (
        <section id="the-problem" class="scroll-mt-10 space-y-4 pt-6 border-t border-[var(--color-border-subtle)]">
          <h2 class="text-2xl font-medium tracking-tight text-[var(--color-ink-primary)]">
            {t('case.nav.problem')}
          </h2>
          <div class="text-base sm:text-lg leading-relaxed text-[var(--color-ink-secondary)] space-y-4">
            <p>{data.inThisCase.problem}</p>
          </div>
        </section>
      )}

      {data.inThisCase?.approach && (
        <section id="my-approach" class="scroll-mt-10 space-y-4 pt-6 border-t border-[var(--color-border-subtle)]">
          <h2 class="text-2xl font-medium tracking-tight text-[var(--color-ink-primary)]">
            {t('case.nav.approach')}
          </h2>
          <div class="text-base sm:text-lg leading-relaxed text-[var(--color-ink-secondary)] space-y-4">
            <p>{data.inThisCase.approach}</p>
          </div>
        </section>
      )}

      {data.inThisCase?.coreChallenge && (
        <section id="core-challenge" class="scroll-mt-10 space-y-4 pt-6 border-t border-[var(--color-border-subtle)]">
          <h2 class="text-2xl font-medium tracking-tight text-[var(--color-ink-primary)]">
            {t('case.nav.challenge')}
          </h2>
          <div class="text-base sm:text-lg leading-relaxed text-[var(--color-ink-secondary)] space-y-4">
            <p>{data.inThisCase.coreChallenge}</p>
          </div>
        </section>
      )}

      {data.inThisCase?.designSystem && (
        <section id="scalable-design-system" class="scroll-mt-10 space-y-4 pt-6 border-t border-[var(--color-border-subtle)]">
          <h2 class="text-2xl font-medium tracking-tight text-[var(--color-ink-primary)]">
            {t('case.nav.system')}
          </h2>
          <div class="text-base sm:text-lg leading-relaxed text-[var(--color-ink-secondary)] space-y-4">
            <p>{data.inThisCase.designSystem}</p>
          </div>
        </section>
      )}

      {data.inThisCase?.outcome && (
        <section id="outcome" class="scroll-mt-10 space-y-4 pt-6 border-t border-[var(--color-border-subtle)]">
          <h2 class="text-2xl font-medium tracking-tight text-[var(--color-ink-primary)]">
            {t('case.nav.outcome')}
          </h2>
          <div class="text-base sm:text-lg leading-relaxed text-[var(--color-ink-secondary)] space-y-4">
            <p>{data.inThisCase.outcome}</p>
          </div>
        </section>
      )}
    </div>

    <!-- Contenido enriquecido libre escrito en el cuerpo del archivo MDX -->
    <div class="prose prose-neutral max-w-none my-12 text-[var(--color-ink-secondary)]">
      <slot />
    </div>

    <!-- Testimonio / Voices from the project -->
    {data.testimonial && (
      <Testimonial
        quote={data.testimonial.quote}
        author={data.testimonial.author}
        title={data.testimonial.title}
        date={data.testimonial.date}
      />
    )}

    <!-- Footer transversal del proyecto -->
    <ProjectFooter nextProject={data.nextProject} />
  </article>
</BaseLayout>