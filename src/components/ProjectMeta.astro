---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  client?: string;
  timeline?: string;
  role?: string;
}

const { client, timeline, role } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const hasMeta = Boolean(client || timeline || role);
---

{hasMeta && (
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-6">
    {client && (
      <div class="rounded-2xl border border-border-subtle bg-canvas px-5 py-4">
        <p class="font-mono text-[11px] uppercase tracking-wider text-ink-muted mb-1">{t('case.project')}</p>
        <p class="font-bold text-sm sm:text-base text-ink-primary">{client}</p>
      </div>
    )}
    {timeline && (
      <div class="rounded-2xl border border-border-subtle bg-canvas px-5 py-4">
        <p class="font-mono text-[11px] uppercase tracking-wider text-ink-muted mb-1">{t('case.timeline')}</p>
        <p class="font-bold text-sm sm:text-base text-ink-primary">{timeline}</p>
      </div>
    )}
    {role && (
      <div class="rounded-2xl border border-border-subtle bg-canvas px-5 py-4">
        <p class="font-mono text-[11px] uppercase tracking-wider text-ink-muted mb-1">{t('case.role')}</p>
        <p class="font-bold text-sm sm:text-base text-ink-primary">{role}</p>
      </div>
    )}
  </div>
)}