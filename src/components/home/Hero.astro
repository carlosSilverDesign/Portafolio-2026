---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { site } from '../../config/site';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Si existe /public/avatar.jpg se usa la foto; si no, un placeholder SVG minimalista.
const hasAvatar = existsSync(join(process.cwd(), 'public', site.avatarPath));
---

<section id="top" aria-labelledby="hero-title" class="pt-6 pb-14 md:pt-10 md:pb-24">
  <h1
    id="hero-title"
    class="text-[clamp(3.25rem,10vw,8.75rem)] font-bold leading-[0.86] tracking-[-0.045em] text-ink-primary"
  >
    <span class="block">{t('hero.title.line1')}</span>
    <!-- pb/-mb compensan el recorte de descendentes (g, p) con background-clip: text -->
    <span class="block pb-[0.12em] -mb-[0.12em] bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-500 bg-clip-text text-transparent">
      {t('hero.title.line2')}
    </span>
  </h1>

  <div class="mt-12 md:mt-20 grid grid-cols-1 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] gap-10 lg:gap-16 items-end">
    <div class="space-y-6">
      <p class="max-w-[22ch] text-2xl md:text-[28px] font-bold leading-[1.1] tracking-[-0.02em] text-ink-primary">
        {t('hero.lead')}
      </p>

      <!-- Acceso directo a Proyectos y Contacto desde el inicio -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 rounded-full bg-accent-blue px-5 py-2.5 text-xs font-mono font-semibold text-white hover:bg-blue-700 transition-colors"
        >
          <span>{t('hero.cta.projects')}</span>
          <ArrowDown class="size-3.5" aria-hidden="true" />
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full border border-border-subtle bg-surface px-5 py-2.5 text-xs font-mono font-semibold text-ink-primary hover:border-accent-blue hover:text-accent-blue transition-colors"
        >
          <span>{t('hero.cta.contact')}</span>
          <ArrowUpRight class="size-3.5" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="flex flex-col-reverse sm:flex-row sm:items-end gap-8">
      <p class="max-w-[46ch] text-base md:text-lg leading-snug text-ink-secondary">
        {t('hero.copy')}
      </p>

      <figure class="group relative shrink-0 self-start sm:self-end" tabindex="0" aria-label={site.name}>
        <span
          role="tooltip"
          class="pointer-events-none absolute bottom-full left-1/2 mb-3 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-full bg-accent-blue px-3 py-1.5 font-mono text-[11px] text-white opacity-0 transition-all duration-300 ease-[var(--ease-snappy)] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
        >
          {site.name} · {site.location}
        </span>

        <div class="size-24 md:size-32 lg:size-36 overflow-hidden rounded-full ring-1 ring-border-subtle transition-shadow duration-300 group-hover:shadow-[0_24px_56px_rgb(0_85_255/0.18)]">
          {hasAvatar ? (
            <img
              src={site.avatarPath}
              alt={t('hero.avatarAlt')}
              width="288"
              height="288"
              decoding="async"
              class="size-full object-cover object-top"
            />
          ) : (
            <svg viewBox="0 0 144 144" class="size-full" role="img" aria-label={t('hero.avatarAlt')}>
              <defs>
                <linearGradient id="avatar-bg" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#EFF6FF" />
                  <stop offset="100%" stop-color="#DBEAFE" />
                </linearGradient>
              </defs>
              <rect width="144" height="144" fill="url(#avatar-bg)" />
              <circle cx="72" cy="58" r="22" fill="none" stroke="#0055FF" stroke-width="2" />
              <path d="M30 128c6-24 23-36 42-36s36 12 42 36" fill="none" stroke="#0055FF" stroke-width="2" stroke-linecap="round" />
            </svg>
          )}
        </div>
      </figure>
    </div>
  </div>
</section>
