---
import { ArrowUp } from '@lucide/astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';
import { site } from '../../config/site';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="flex flex-col gap-4 border-t border-border-subtle pt-8 font-mono text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
  <p>© {new Date().getFullYear()} {site.name} — {t('footer.rights')}</p>
  <p class="text-ink-secondary">{t('footer.tagline')}</p>
  <a href="#top" class="inline-flex items-center gap-1.5 transition-colors hover:text-accent-blue">
    <span>{t('nav.backToTop')}</span>
    <ArrowUp class="size-3.5" aria-hidden="true" />
  </a>
</footer>
