---
import SectionShell from './SectionShell.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<SectionShell id="sobre-mi" kicker={t('manifesto.kicker')} ariaLabel={t('manifesto.kicker')}>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] gap-12 lg:gap-16 items-start">
    <!-- Bloque 1: Ubicación -->
    <h2 class="max-w-[15ch] text-[clamp(2.25rem,4.6vw,4.25rem)] font-bold leading-[0.95] tracking-[-0.04em] text-ink-primary">
      {t('manifesto.location')}
    </h2>

    <!-- Bloque 2: Manifiesto -->
    <div class="lg:pt-3">
      <p class="text-[clamp(1.75rem,3vw,2.75rem)] font-bold leading-[1] tracking-[-0.03em] text-ink-primary">
        {t('manifesto.statement')}
      </p>
      <p class="mt-10 md:mt-16 max-w-[52ch] text-base md:text-lg leading-snug text-ink-secondary">
        {t('manifesto.copy')}
      </p>
    </div>
  </div>
</SectionShell>
