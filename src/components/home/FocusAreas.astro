---
import SectionShell from './SectionShell.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage, UIKey } from '../../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const areas = [1, 2, 3, 4, 5, 6, 7].map((n) => ({
  index: n.toString().padStart(2, '0'),
  label: t(`focus.${n}` as UIKey),
}));
---

<SectionShell id="enfoque" kicker={t('focus.kicker')} title={t('focus.title')}>
  <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-7 gap-2.5">
    {areas.map(({ index, label }) => (
      <li class="flex flex-col justify-between gap-8 min-h-[140px] md:min-h-[160px] p-4 md:p-5 rounded-2xl bg-surface border border-border-subtle transition-colors duration-300 hover:border-accent-blue-border hover:bg-accent-blue-subtle/40">
        <span aria-hidden="true" class="text-2xl md:text-[30px] font-bold leading-[0.85] tracking-[-0.04em] text-accent-blue tabular-nums">
          {index}
        </span>
        <p class="text-base md:text-lg font-bold leading-[1.02] tracking-[-0.015em] text-ink-primary break-words">
          {label}
        </p>
      </li>
    ))}
  </ul>
</SectionShell>
