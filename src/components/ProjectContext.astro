---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  overview?: string;
  toolsAndMethods?: string[];
  team?: string[];
}

const { overview, toolsAndMethods, team } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="space-y-8 my-10">
  {overview && (
    <div class="space-y-3">
      <h3 class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink-muted)]">
        {t('case.overview')}
      </h3>
      <p class="text-base sm:text-lg leading-relaxed text-[var(--color-ink-secondary)]">
        {overview}
      </p>
    </div>
  )}

  {(toolsAndMethods?.length || team?.length) && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {toolsAndMethods && toolsAndMethods.length > 0 && (
        <div class="p-6 rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)]">
          <h4 class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink-muted)] mb-4">
            {t('case.tools')}
          </h4>
          <ul class="space-y-2 text-sm text-[var(--color-ink-secondary)]">
            {toolsAndMethods.map((tool) => (
              <li class="flex items-start gap-2">
                <span class="text-[var(--color-ink-primary)] select-none">•</span>
                <span>{tool}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {team && team.length > 0 && (
        <div class="p-6 rounded-xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)]">
          <h4 class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink-muted)] mb-4">
            {t('case.team')}
          </h4>
          <ul class="space-y-2 text-sm text-[var(--color-ink-secondary)]">
            {team.map((member) => (
              <li class="flex items-start gap-2">
                <span class="text-[var(--color-ink-primary)] select-none">•</span>
                <span>{member}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</div>