---
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<div role="group" aria-label="Language Selector" class="inline-flex items-center gap-1.5 text-[12px] sm:text-[13px] font-bold leading-none">
  {
    Object.entries(languages).map(([langKey, label], idx) => {
      const isActive = currentLang === langKey;
      const targetUrl = getLocalizedPath(currentPath, langKey as SupportedLanguage);

      return (
        <>
          {idx > 0 && <span class="text-border-subtle font-normal select-none" aria-hidden="true">/</span>}
          <a
            href={targetUrl}
            class:list={[
              'transition-colors duration-200 select-none',
              isActive
                ? 'text-accent-blue'
                : 'text-ink-muted hover:text-ink-primary',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        </>
      );
    })
  }
</div>