---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { FileDown, Mail, ArrowUpRight } from '@lucide/astro';
import { site } from '../config/site';

interface Props {
  resumeUrl?: string;
  email?: string;
  linkedinUrl?: string;
}

const {
  resumeUrl = site.cvUrl,
  email = site.email,
  linkedinUrl = site.linkedinUrl,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="mt-14 pt-8 border-t border-border-subtle space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
    <a
      href={resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-accent-blue-border bg-accent-blue-subtle text-accent-blue font-semibold hover:bg-accent-blue hover:text-white transition-colors"
    >
      <FileDown class="size-3.5" aria-hidden="true" />
      <span>{t('footer.resume')}</span>
    </a>

    <a
      href={`mailto:${email}`}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border-subtle bg-surface text-ink-primary font-medium hover:border-accent-blue hover:text-accent-blue transition-colors"
    >
      <Mail class="size-3.5 text-accent-blue" aria-hidden="true" />
      <span>{email}</span>
    </a>

    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border-subtle bg-surface text-ink-primary font-medium hover:border-accent-blue hover:text-accent-blue transition-colors"
    >
      <span>{t('footer.linkedin')}</span>
      <ArrowUpRight class="size-3.5 text-accent-blue" aria-hidden="true" />
    </a>
  </div>

  <p class="text-center font-mono text-[11px] text-ink-muted">
    © {new Date().getFullYear()} {site.name} — {t('footer.rights')}
  </p>
</footer>