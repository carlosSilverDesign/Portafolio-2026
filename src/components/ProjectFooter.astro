---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ArrowUpRight, FileDown, Mail } from '@lucide/astro';

interface Props {
  nextProject?: {
    slug: string;
    title: string;
  };
  resumeUrl?: string;
  email?: string;
  linkedinUrl?: string;
}

const {
  nextProject,
  resumeUrl = "/cv-2026.pdf",
  email = "tu-correo@ejemplo.com",
  linkedinUrl = "https://linkedin.com/in/tu-perfil",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="mt-20 pt-12 border-t border-[var(--color-border-subtle)] space-y-12">
  {nextProject && (
    <a
      href={lang === 'es' ? `/projects/${nextProject.slug}` : `/${lang}/projects/${nextProject.slug}`}
      class="group block p-8 rounded-2xl border border-[var(--color-border-subtle)] bg-[var(--color-surface)] hover:border-black transition-colors"
    >
      <p class="font-mono text-xs text-[var(--color-ink-muted)] mb-2">{t('footer.nextProject')}</p>
      <div class="flex items-center justify-between">
        <h4 class="text-xl sm:text-2xl font-medium tracking-tight group-hover:translate-x-1 transition-transform">
          {nextProject.title}
        </h4>
        <ArrowUpRight class="w-6 h-6 text-[var(--color-ink-muted)] group-hover:text-black group-hover:rotate-45 transition-all" />
      </div>
    </a>
  )}

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 font-mono text-xs">
    <div class="flex flex-wrap items-center gap-4">
      <a
        href={resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--color-border-subtle)] hover:border-black hover:bg-neutral-100 transition-colors"
      >
        <FileDown class="w-3.5 h-3.5" />
        <span>{t('footer.resume')}</span>
      </a>

      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--color-border-subtle)] hover:border-black hover:bg-neutral-100 transition-colors"
      >
        <Mail class="w-3.5 h-3.5" />
        <span>{email}</span>
      </a>

      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[var(--color-border-subtle)] hover:border-black hover:bg-neutral-100 transition-colors"
      >
        <!-- Icono nativo de LinkedIn -->
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
        </svg>
        <span>LinkedIn</span>
      </a>
    </div>

    <p class="text-[var(--color-ink-muted)]">
      © {new Date().getFullYear()} — {t('footer.rights')}
    </p>
  </div>
</footer>