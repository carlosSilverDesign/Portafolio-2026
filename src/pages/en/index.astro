---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/home/Hero.astro';
import Numbers from '../../components/home/Numbers.astro';
import Services from '../../components/home/Services.astro';
import Projects from '../../components/home/Projects.astro';
import Process from '../../components/home/Process.astro';
import DeliveryFormat from '../../components/home/DeliveryFormat.astro';
import FocusAreas from '../../components/home/FocusAreas.astro';
import Manifesto from '../../components/home/Manifesto.astro';
import Contact from '../../components/home/Contact.astro';
import HomeFooter from '../../components/home/HomeFooter.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

const lang: SupportedLanguage = 'en';
const t = useTranslations(lang);
---

<BaseLayout title={t('meta.title')} description={t('meta.description')} width="wide">
  <Navbar />

  <Hero lang={lang} />
  <Numbers lang={lang} />
  <Projects lang={lang} />
  <Services lang={lang} />
  <Process lang={lang} />
  <DeliveryFormat lang={lang} />
  <FocusAreas lang={lang} />
  <Manifesto lang={lang} />
  <Contact lang={lang} />
  <HomeFooter lang={lang} />
</BaseLayout>